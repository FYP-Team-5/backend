# Copy to .env before running Docker Compose.
API_PORT=8002
POSTGRES_PORT=5433
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional inbound API authentication for frontend requests.
API_KEY=
CORS_ORIGINS=*

POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=user

# Use the same strong secret, issuer, and audience in services that verify tokens.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=user-service
JWT_AUDIENCE=assessment-services
ACCESS_TOKEN_EXPIRY_MINUTES=30

# Required only by POST /api/v1/auth/register/staff.
STAFF_REGISTRATION_KEY=key

# OpenAI-compatible LLM endpoint running on the Docker host (for example Ollama).
LLM_URL=http://host.docker.internal:11434/v1/chat/completions
LLM_MODEL=local-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000

MAX_ANSWER_CHARACTERS=50000

# Persistent grading worker
GRADING_POLL_SECONDS=1
GRADING_LEASE_SECONDS=60
GRADING_MAX_RETRIES=3
GRADING_RETRY_SECONDS=5

# SeaweedFS S3 storage (Compose uses the internal seaweedfs service endpoint).
DATASET_S3_ENDPOINT=http://localhost:8333
DATASET_S3_BUCKET=llm-training
DATASET_S3_ACCESS_KEY=fyp-training
DATASET_S3_SECRET_KEY=replace-with-a-strong-storage-secret
DATASET_S3_REGION=us-east-1
DATASET_UPLOAD_MAX_BYTES=52428800
DATASET_POLL_SECONDS=5
DATASET_LEASE_SECONDS=120
DATASET_MAX_RETRIES=3
DATASET_RETRY_SECONDS=5
