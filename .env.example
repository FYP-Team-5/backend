# Copy to .env before running Docker Compose.
API_PORT=8002
POSTGRES_PORT=5433
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=*

POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=user

# Use the same strong secret, issuer, and audience in services that verify tokens.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=user-service
JWT_AUDIENCE=assessment-services
ACCESS_TOKEN_EXPIRY_MINUTES=30

# Required only by POST /api/v1/auth/register/staff.
STAFF_REGISTRATION_KEY=replace-with-a-random-bootstrap-key
