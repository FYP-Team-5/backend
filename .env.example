# Copy to .env before running Docker Compose.
API_PORT=8002
POSTGRES_PORT=5433
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional inbound API authentication for frontend requests.
API_KEY=
CORS_ORIGINS=*

POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=user
QDRANT_API_KEY=
QDRANT_COLLECTION=rubric_chunks
QDRANT_TIMEOUT_SECONDS=30

# Use the same strong secret, issuer, and audience in services that verify tokens.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=user-service
JWT_AUDIENCE=assessment-services
ACCESS_TOKEN_EXPIRY_MINUTES=30

# Required only by POST /api/v1/auth/register/staff.
STAFF_REGISTRATION_KEY=replace-with-a-random-bootstrap-key

# OpenAI-compatible LLM endpoint running on the Docker host (for example Ollama).
LLM_URL=http://host.docker.internal:11434/v1/chat/completions
LLM_MODEL=local-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2000

MAX_ANSWER_CHARACTERS=50000